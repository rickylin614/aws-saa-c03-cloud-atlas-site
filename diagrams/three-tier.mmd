%% 跨可用區的三層 Web 架構
%% 從使用者請求往下追：入口、運算與資料層各自負責什麼？
%% https://docs.aws.amazon.com/whitepapers/latest/web-application-hosting-best-practices/welcome.html
flowchart LR
  users["使用者 · HTTPS"]
  edge["CloudFront + WAF · 快取與 HTTP 請求防護"]
  alb["Application LB · 跨 AZ 的公開入口"]
  a["EC2 / ECS · Private subnet · ASG"]
  b["EC2 / ECS · Private subnet · ASG"]
  db["RDS primary · DB subnet · 僅應用層可連"]
  standby["RDS standby · Multi-AZ DB instance"]
  users -->|"請求"| edge
  edge -->|"快取未命中"| alb
  alb -->|"健康目標"| a
  alb -->|"健康目標"| b
  a -->|"SQL"| db
  b -->|"SQL"| db
  db -->|"同步複寫"| standby
